<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#2A2929"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnEditorBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/back"
            android:tint="#EFEFEF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/editorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="filename.txt"
                android:textColor="#EFEFEF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editorMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="UTF-8 • 0 lines"
                android:textColor="#BDBDBD"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnEditorFind"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="FIND"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEditorWrap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="WRAP"
            android:textColor="#62B1B0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEditorSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:text="SAVE"
            android:textColor="#62B1B0"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Collapsible Find Bar -->
    <LinearLayout
        android:id="@+id/editorSearchBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#252526"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/editorSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Find text..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#EFEFEF"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/editorSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:text="0/0"
            android:textColor="#BDBDBD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnEditorFindNext"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="NEXT"
            android:textColor="#62B1B0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEditorCloseSearch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:text="✕"
            android:textColor="#BDBDBD"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3A3A3A" />

    <!-- Main Scrollable Code & Text Area -->
    <ScrollView
        android:id="@+id/editorVerticalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editorLineNumbers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#252526"
                android:fontFamily="monospace"
                android:gravity="end"
                android:lineSpacingMultiplier="1.15"
                android:minWidth="42dp"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="24dp"
                android:text="1"
                android:textColor="#7A7A7A"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#333333" />

            <EditText
                android:id="@+id/editorContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="flagNoEnterAction"
                android:lineSpacingMultiplier="1.15"
                android:minHeight="400dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp"
                android:scrollHorizontally="false"
                android:textColor="#EFEFEF"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>