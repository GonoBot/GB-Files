<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookmarksRoot"          
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#353434">

    <!-- HEADER (#2E2D2D) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#2E2D2D">

        <ImageView
            android:id="@+id/btnBookmarksBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/arrow_back"
            android:tint="#EFEFEF"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="Bookmarks"
            android:textColor="#EFEFEF"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 4 CATEGORY TABS (Folders, Files, Apps, Images) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="#2E2D2D">

        <TextView
            android:id="@+id/tabFolders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Folders"
            android:textColor="#62B1B0"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tabFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Files"
            android:textColor="#BDBDBD"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Apps"
            android:textColor="#BDBDBD"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tabImages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Images"
            android:textColor="#BDBDBD"
            android:textSize="14sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#555252"/>

    <!-- BOOKMARK LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/bookmarksListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"/>
    </ScrollView>
</LinearLayout>