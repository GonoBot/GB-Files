<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2E2D2D">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#262626">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:tint="#62B1B0"
            android:src="@drawable/header_logo"
            android:contentDescription="Gonofiles Logo"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/currentPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/storage/emulated/0/"
                android:textColor="#EFEFEF"
                android:textSize="18sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/currentFolderInfo"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Folders: —  Files: —  Disk: —"
                android:textColor="#BDBDBD"
                android:textSize="9sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            android:tint="#EFEFEF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- DUAL FILE PANES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT PANE -->
        <LinearLayout
            android:id="@+id/leftPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#353434">

            <TextView
                android:id="@+id/leftPanelHeader"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="LEFT PANEL"
                android:textColor="#62B1B0"
                android:textStyle="bold"
                android:textSize="12sp"/>
            
            <!-- LEFT PANEL RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/leftFileList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:fadeScrollbars="true" />
            
        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#555252"/>

        <!-- RIGHT PANE -->
        <LinearLayout
            android:id="@+id/rightPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#353434">

            <TextView
                android:id="@+id/rightPanelHeader"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="RIGHT PANEL"
                android:textColor="#62B1B0"
                android:textStyle="bold"
                android:textSize="12sp"/>
            
            <!-- RIGHT PANEL RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rightFileList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:fadeScrollbars="true" />
            
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Normal Toolbar (Slim 44dp height) -->
    <LinearLayout
        android:id="@+id/normalToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#262626"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/toolbar_back_arrow" />

        <ImageView
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/toolbar_fordward_arrow" />

        <ImageView
            android:id="@+id/btnNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/add" />

        <ImageView
            android:id="@+id/btnMirror"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/mirror" />

        <ImageView
            android:id="@+id/btnParent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/back" />
    </LinearLayout>

    <!-- Bottom Selection Toolbar (Matching 44dp height) -->
    <LinearLayout
        android:id="@+id/selectionToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#262626"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/check_box" />

        <ImageView
            android:id="@+id/btnClearSelection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/close_small" />

        <ImageView
            android:id="@+id/btnInvertSelection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:tint="#EFEFEF"
            android:scaleType="fitCenter"
            android:src="@drawable/invert" />
    </LinearLayout>

</LinearLayout>