<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zipRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#353434">

    <!-- HEADER (#2E2D2D) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#2E2D2D">

        <ImageView
            android:id="@+id/btnZipBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/arrow_back"
            android:tint="#EFEFEF"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/zipArchiveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="archive.zip"
                android:textColor="#EFEFEF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/zipInternalPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/"
                android:textColor="#62B1B0"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="start"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnZipExtractAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Extract All"
            android:textColor="#62B1B0"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- ZIP CONTENTS LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/zipEntriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"/>
    </ScrollView>
</LinearLayout>