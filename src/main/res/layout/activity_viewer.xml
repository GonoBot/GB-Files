<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CONTENT STAGE -->
    <ImageView
        android:id="@+id/viewerImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

    <VideoView
        android:id="@+id/viewerVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"/>
    
    <!-- Dedicated touch layer over VideoView so taps always register even when locked -->
    <View
        android:id="@+id/videoTouchCatcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"/>

    <!-- OVERLAY CONTROLS (Fades on tap in Image/Video) -->
    <RelativeLayout
        android:id="@+id/viewerOverlayLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/viewerTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#CC2E2D2D">

            <ImageView
                android:id="@+id/btnViewerBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/arrow_back"
                android:tint="#EFEFEF"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/viewerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="File"
                    android:textColor="#EFEFEF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="middle"/>

                <TextView
                    android:id="@+id/viewerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:visibility="gone"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btnViewerMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                android:tint="#EFEFEF"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:contentDescription="More options" />
        </LinearLayout>

        <!-- VIDEO SIDE BUTTONS: Center-Left & Center-Right (Hidden by default) -->
        <ImageView
            android:id="@+id/btnVideoLock"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:padding="11dp"
            android:src="@drawable/lock_open"
            android:tint="#EFEFEF"
            android:background="#992E2D2D"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/btnVideoRotate"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="14dp"
            android:padding="11dp"
            android:src="@drawable/mobile_rotate"
            android:tint="#EFEFEF"
            android:background="#992E2D2D"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <!-- IMAGE VIEWER BOTTOM BAR (Checkbox | 1/127 | Share) -->
        <LinearLayout
            android:id="@+id/imageBottomBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#CC2E2D2D"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/chkImageSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#62B1B0"/>

            <TextView
                android:id="@+id/imageCounterTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1/1"
                android:textColor="#EFEFEF"
                android:textSize="15sp"/>

            <ImageView
                    android:id="@+id/btnImageShare"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/share"
                    android:tint="#EFEFEF"
                    android:clickable="true"
                    android:focusable="true"/>
        </LinearLayout>

        <!-- VIDEO PLAYER BOTTOM BAR (Scrubber + Prev | -10s | Play | +10s | Next) -->
        <LinearLayout
            android:id="@+id/videoBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#CC2E2D2D"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/videoCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#EFEFEF"
                    android:textSize="12sp"/>

                <SeekBar
                    android:id="@+id/videoSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#62B1B0"
                    android:thumbTint="#62B1B0"/>

                <TextView
                    android:id="@+id/videoTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#EFEFEF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/btnVidPrev"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="11dp"
                    android:src="@drawable/arrow_left"
                    android:tint="#EFEFEF"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/btnVidBack10"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="11dp"
                    android:src="@drawable/rotate_left"
                    android:tint="#EFEFEF"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/btnVidPlayPause"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/pause"
                    android:tint="#62B1B0"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/btnVidFwd10"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="11dp"
                    android:src="@drawable/rotate_right"
                    android:tint="#EFEFEF"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/btnVidNext"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="11dp"
                    android:src="@drawable/arrow_right"
                    android:tint="#EFEFEF"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PDF SLIDER BAR (#413F3F with Prev/Next Buttons + Smooth SeekBar) -->
        <LinearLayout
            android:id="@+id/pdfControlsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:background="#413F3F"
            android:visibility="gone">

            <TextView
                android:id="@+id/pdfPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginBottom="4dp"
                android:background="#62B1B0"
                android:text="1 / 1"
                android:textColor="#2E2D2D"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnPdfPrev"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="&#9664;"
                    android:textColor="#62B1B0"
                    android:textSize="18sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/pdfPageSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#62B1B0"
                    android:thumbTint="#62B1B0"/>

                <TextView
                    android:id="@+id/btnPdfNext"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="&#9654;"
                    android:textColor="#62B1B0"
                    android:textSize="18sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- FLOATING UNLOCK BUTTON (Hidden until user taps Lock during video playback) -->
    <ImageView
        android:id="@+id/btnVideoUnlockOnly"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="14dp"
        android:padding="11dp"
        android:src="@drawable/lock"
        android:tint="#62B1B0"
        android:background="#CC2E2D2D"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>
</FrameLayout>
